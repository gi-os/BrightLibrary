<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Shake-to-report posts the issue to GitHub, the shelf looks up missing cover art on Open
      Library, and the LIBRARY screen browses a Calibre server over OPDS.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Lets the shelf show cover art in colour, by switching off the display-wide daltonizer that
      makes LightOS monochrome. It is signature|privileged|development, so it can only ever be
      granted once, over adb:

        adb shell pm grant com.lightfastread android.permission.WRITE_SECURE_SETTINGS

      Declaring it costs nothing without the grant - every write is wrapped and the
      SecurityException swallowed, so covers just stay grey. `tools:ignore` because lint flags it
      as a permission an ordinary app can never hold, which is exactly the point.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      android:usesCleartextTraffic below is for Calibre. A server on a home LAN is http on a high
      port, and nobody puts a certificate on 192.168.x.x; Android has blocked cleartext by default
      since API 28, which would make the LIBRARY screen fail with an unexplained connection error on
      the one address it is most likely to be pointed at. Everything else the app talks to - GitHub,
      Open Library - is https regardless of this flag.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LightBooks">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LightBooks">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />
    </application>

</manifest>